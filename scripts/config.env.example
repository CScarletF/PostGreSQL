# Copy this file to config.env (gitignored) and fill in real values.
# scripts/setup.sh reads this file -- nothing here should ever be
# committed with real secrets filled in.

# Postgres superuser password (from /etc/patroni/patroni.yml on either
# cluster node, under postgresql.authentication.superuser.password)
WEBAPP_SUPERUSER_PASSWORD=

# Keepalived VIP + HAProxy "master" listener port -- always routes to
# whichever node is currently Patroni primary
WEBAPP_VIP=192.168.20.190
WEBAPP_VIP_PORT=5000

# Application database + scoped role
WEBAPP_DB_NAME=webapp_demo
WEBAPP_APP_USER=webapp_app

# Path to app-framework's modules/ folder AS IT EXISTS ON TARGET_HOST
# (not on this control node) -- webapp_postgres.yml runs against
# TARGET_HOST directly, since that's where app-framework lives
WEBAPP_MODULES_DIR=/home/jenkins/app-framework/modules

# Inventory host (IP, matching the inventory file) that runs the app
# and holds app-framework's modules/ folder
TARGET_HOST=192.168.20.177

# Path to this repo's inventory file
INVENTORY_PATH=inventory

# SSH private keys as they exist on THIS control node's real home dir
# (not /root/.ssh/ -- the script symlinks them there for you)
SSH_KEY_CONTROLLER=/home/srv-deploy-eng/.ssh/ansible_srv_deploy_eng_key
SSH_KEY_TARGET=/home/srv-deploy-eng/.ssh/ansible_jenkins_key