# Copy this to webapp_postgres_secrets.yml (no .example) and fill in
# the real value. That file must be gitignored -- add it to
# .gitignore before running the playbook, if it isn't already covered.
#
# Value comes from /etc/patroni/patroni.yml on any cluster node, under
# postgresql.authentication.superuser.password.

webapp_postgres_superuser_password: "REPLACE_ME"
